{
  "name": "agent-v",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test": "npm run test:engine && npm run build && npm run test:render",
    "test:engine": "node --experimental-strip-types --test tests/security-engine.test.mjs tests/api-security.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:audit": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "cf:whoami": "wrangler whoami",
    "cf:db:create": "wrangler d1 create agent-shield-db --binding DB --update-config",
    "cf:db:apply": "wrangler d1 execute agent-shield-db --remote --file=drizzle/0000_friendly_beast.sql",
    "cf:secret:groq": "wrangler secret put GROQ_API_KEY",
    "cf:secret:admin": "wrangler secret put AGENTSHIELD_ADMIN_TOKEN"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module",
  "displayName": "Agent V",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true
  }
}
